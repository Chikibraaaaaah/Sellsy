# --- API v2 (OAuth 2, client_credentials) ---
# Créer un accès API "privé" dans Sellsy : Réglages > Portail développeur (à vérifier dans ton compte)
SELLSY_V2_CLIENT_ID=
SELLSY_V2_CLIENT_SECRET=
# URL du jeton : À VÉRIFIER dans https://api.sellsy.com/doc/v2/#section/Authentication
SELLSY_V2_TOKEN_URL=https://login.sellsy.com/oauth2/access-tokens
SELLSY_V2_BASE_URL=https://api.sellsy.com/v2

# --- API v1 (OAuth 1.0) --- source : https://docs.sellsy.com/api/v1/documentation/oauth
SELLSY_V1_ENDPOINT=https://apifeed.sellsy.com/0/
SELLSY_V1_CONSUMER_TOKEN=
SELLSY_V1_CONSUMER_SECRET=
SELLSY_V1_USER_TOKEN=
SELLSY_V1_USER_SECRET=

PORT=3000
