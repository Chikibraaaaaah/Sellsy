{
  "object": "subscriptions",
  "operation": "updateSubscription",
  "sourceSchema": "SubscriptionPut",
  "fields": [
    {
      "field": "sending.mode",
      "required": false,
      "type": "string",
      "enum": [
        "automatic",
        "manual"
      ],
      "example": "automatic",
      "description": "Once the invoice has been generated, from subscription deadline, if sending mode is automatic, email will be sent to all recipients, otherwise, if it's manual, email should be send manually"
    },
    {
      "field": "sending.recipients",
      "type": "array",
      "items": "object",
      "required": false,
      "description": "Email recipients"
    },
    {
      "field": "sending.email_template",
      "required": false,
      "type": "integer",
      "nullable": true,
      "example": 12,
      "description": "Id of email template. If not specified, the default email layout will be used"
    },
    {
      "field": "preferences_source",
      "required": false,
      "type": "string",
      "enum": [
        "model",
        "related"
      ],
      "description": "Source of payment preferences"
    },
    {
      "field": "related[]",
      "type": "array",
      "required": false,
      "description": "Contact the generated invoices are addressed to <br/><br/> - Only the contact can be updated: the client of the subscription cannot be changed <br/> - The contact must be linked to the client of the subscription <br/> - Send an empty array to remove the contact\n"
    },
    {
      "field": "related[].id",
      "required": false,
      "type": "integer",
      "example": 234,
      "description": "ID of the contact"
    },
    {
      "field": "related[].type",
      "required": false,
      "type": "string",
      "enum": [
        "contact"
      ],
      "example": "contact",
      "description": "Type of related"
    },
    {
      "field": "billing_address",
      "required": false,
      "type": "integer",
      "nullable": true,
      "example": 69,
      "description": "Id of billing address"
    },
    {
      "field": "shipping_address",
      "required": false,
      "type": "integer",
      "nullable": true,
      "example": 67,
      "description": "Id of shipping address"
    },
    {
      "field": "order_reference",
      "required": false,
      "type": "string",
      "nullable": true,
      "maxLength": 100,
      "example": "reference",
      "description": "Order reference"
    },
    {
      "field": "has_updated_catalog_prices",
      "required": false,
      "type": "boolean",
      "description": "Update prices according to the products or services in the catalog"
    },
    {
      "field": "has_catalog_promotions",
      "required": false,
      "type": "boolean",
      "description": "Take into account catalog promotions"
    },
    {
      "field": "has_display_of_next_deadline",
      "required": false,
      "type": "boolean",
      "description": "Display the next recurrence date on the invoice"
    },
    {
      "field": "has_service_dates",
      "required": false,
      "type": "boolean",
      "description": "Display service dates on the invoice"
    },
    {
      "field": "service_dates.start",
      "required": false,
      "type": "string",
      "format": "date",
      "example": "2023-01-01",
      "description": "Start date for service"
    },
    {
      "field": "service_dates.end",
      "required": false,
      "type": "string",
      "format": "date",
      "example": "2023-01-31",
      "description": "End date for service <br/><br/> End date must be greater than start date\n"
    },
    {
      "field": "has_impact_on_stock",
      "required": false,
      "type": "boolean",
      "example": true,
      "description": "Enable stock impact on new invoices generated by subscription <br/><br/> - Prerequisite: The Stock module must be enabled and configured on your account to use this option\n"
    },
    {
      "field": "warehouse_id",
      "required": false,
      "type": "integer",
      "nullable": true,
      "description": "Specify the warehouse stock to be impacted once the invoice is generated <br/><br/> - Prerequisite: `has_impact_on_stock` should be true <br/> - Prerequisite: The Stock module must be enabled and configured on your account to use this option <br/><br/>If specified to null, the default warehouse defined in the Stock module preferences will be used\n"
    },
    {
      "field": "payment_settings.direct_debit",
      "required": false,
      "type": "boolean",
      "example": true,
      "description": "Activate direct debit"
    },
    {
      "field": "payment_settings.mandate",
      "required": false,
      "type": "integer",
      "nullable": true,
      "example": 6,
      "description": "Required if the direct debit module on document model is GoCardless"
    },
    {
      "field": "payment_settings.payment_installment_invoice",
      "required": false,
      "type": "string",
      "enum": [
        "invoice_due_date",
        "invoice_generation_date"
      ],
      "example": "invoice_generation_date",
      "description": "Payment installment invoice"
    }
  ]
}